<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE tiles-definitions PUBLIC "-//Apache Software Foundation//DTD Tiles Configuration 2.1//EN"
	 "http://tiles.apache.org/dtds/tiles-config_2_1.dtd">
	 
<tiles-definitions>

	<definition name="emptyTemplate" template="/WEB-INF/views/layout-empty.jsp">
		<put-attribute name="content" value="" />
	</definition>

	<definition name="/login/*" extends="emptyTemplate">
		<put-attribute name="content" value="/WEB-INF/jsp/login/{1}.jsp" />
	</definition>

	<definition name="/modal/*/*" extends="emptyTemplate">
		<put-attribute name="content" value="/WEB-INF/jsp/{1}/{2}.jsp" />
	</definition>

	<!-- 기본 템플릿 -->
	<definition name="defaultTemplate" template="/WEB-INF/views/layout.jsp">
		<put-attribute name="htmlheader" value="/WEB-INF/views/header.jsp" />
		<put-attribute name="left" value="/WEB-INF/views/left.jsp" />
		<put-attribute name="topbar" value="/WEB-INF/views/topbar.jsp" />
		<put-attribute name="content" value="" />
		<put-attribute name="footer" value="/WEB-INF/views/footer.jsp" />
		<put-attribute name="right" value="/WEB-INF/views/right.jsp" />
	</definition>
	
	<definition name="/*/*" extends="defaultTemplate">
		<put-attribute name="content" value="/WEB-INF/jsp/{1}/{2}.jsp" />
	</definition>
	
</tiles-definitions>