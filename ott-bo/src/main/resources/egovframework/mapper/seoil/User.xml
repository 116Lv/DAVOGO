<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="portal.user.mapper.UserMapper">

	<!-- 직원 목록 -->
	<select id="findUserList" resultType="EgovMap">
		select
			row_number() over() as num, 
			a.*
		from (
			select 
				user_id,
				email,
				signup_date
			from user
			where 1=1
			<if test="@portal.common.util.StringUtil@notEmpty(searchText)">
			and email like concat('%', #{searchText}, '%')
			</if>
			<if test="@portal.common.util.StringUtil@notEmpty(orderColumn)">
			order by 
				<choose>
					<when test='"email".equals(orderColumn)'><!-- 번호 -->
						email ${orderType}
					</when>
					<when test='"signup_date".equals(orderColumn)'>
						signup_date ${orderType}
					</when>
					<otherwise>
						signup_date desc
					</otherwise>
				</choose>
			</if>
			limit #{firstIndex}, #{recordCountPerPage}
		) a
	</select>
	
	<select id="getCountOfUserList" resultType="int">
		select count(*) as tot_cnt
		from user
		where 1=1
		<if test="@portal.common.util.StringUtil@notEmpty(searchText)">
		and email like concat('%', #{searchText}, '%')
		</if>
	</select>
	
	
		
</mapper>
